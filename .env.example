# Application
APP_NAME=ASET
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_V1_STR=/api/v1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DATABASE_URL=sqlite:///./aset.db
# For production:
# DATABASE_URL=postgresql://user:password@localhost:5432/aset
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://localhost:8000"]

# Market Data
YFINANCE_CACHE_TTL=3600
POLYGON_API_KEY=your-polygon-api-key

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=ASET <noreply@aset.local>

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/aset.log

# Sentry (optional error tracking)
SENTRY_DSN=

# Streamlit
STREAMLIT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_TOOLBARMODE=minimal
