# SEC/EdgarTools identity is required for SEC API usage.
EDGAR_IDENTITY=Your Name your-email@example.com
SEC_IDENTITY_NAME=Your Name
SEC_IDENTITY_EMAIL=your-email@example.com

# API hardening; keep origins and hosts explicit in production.
ASET_ENVIRONMENT=development
ASET_ALLOWED_ORIGINS=
ASET_ALLOWED_HOSTS=127.0.0.1,localhost
ASET_MAX_PRICE_POINTS=500
