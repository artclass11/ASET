# Explicit provider mode. Keep "fixture" for deterministic development/tests.
# Use "yfinance" only when the [prices] extra is installed and live Yahoo data is intended.
ASET_PROVIDER=fixture

# Core API hardening.
ASET_ENVIRONMENT=development
ASET_ALLOWED_ORIGINS=
ASET_ALLOWED_HOSTS=127.0.0.1,localhost
ASET_MAX_PRICE_POINTS=500
ASET_BIND_HOST=127.0.0.1
ASET_BIND_PORT=8000

# yfinance request timeout in seconds.
YFINANCE_TIMEOUT_SECONDS=8

# SEC/EdgarTools identity is required for SEC API usage.
EDGAR_IDENTITY=Your Name your-email@example.com
SEC_IDENTITY_NAME=Your Name
SEC_IDENTITY_EMAIL=your-email@example.com
